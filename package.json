{
  "name": "examcure-be",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for ExamCure",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-mongo-tests.mjs vitest",
    "test:watch": "node scripts/run-mongo-tests.mjs watch",
    "test:materials": "node --test tests/material-pipeline.test.mjs",
    "worker:materials": "npm run build && node --env-file-if-exists=.env scripts/process-materials.mjs --watch",
    "worker:materials:once": "npm run build && node --env-file-if-exists=.env scripts/process-materials.mjs --once",
    "setup:mongodb-vector": "node --env-file-if-exists=.env scripts/setup-mongodb-vector-index.mjs",
    "test:database": "npm run build && node scripts/run-mongo-tests.mjs database",
    "db:import": "npm run build && node --env-file-if-exists=.env scripts/import-legacy-export.mjs",
    "db:seed-subjects": "npm run build && node --env-file-if-exists=.env scripts/seed-subjects.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "jszip": "^3.10.1",
    "mongodb": "^7.6.0",
    "nodemailer": "^9.0.6",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
