FROM node:24-bookworm-slim

ENV NODE_ENV=production \
    HOME=/tmp

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      ca-certificates \
      fonts-dejavu-core \
      libreoffice-impress \
      poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --chown=node:node scripts ./scripts

USER node

# Polls the Supabase processing_jobs queue continuously.
CMD ["node", "scripts/process-materials.mjs", "--watch"]
