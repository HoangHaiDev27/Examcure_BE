NODE_ENV=development
PORT=5010
# All app data and vectors use MongoDB. Local replica set: docker compose up -d --wait
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=examcure-rs&directConnection=true
MONGODB_DATABASE=examcure
CORS_ORIGIN=http://localhost:3000
# Public URL seen by the browser (Next.js forwards /api/v1 to this backend).
API_PUBLIC_URL=http://localhost:3000/api/v1
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
COOKIE_SAME_SITE=lax
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
DEV_EXPOSE_OTP=true

# Optional OAuth, configure all three together. Redirect goes through Next.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# When Google is enabled: http://localhost:3000/api/v1/Auth/google/callback

# Required for production OTP delivery; local fallback prints codes to terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ExamCure <no-reply@examcure.local>

# Local filesystem; production requires private S3-compatible storage.
STORAGE_DRIVER=local
STORAGE_PATH=./data/files
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# One-time first-admin setup; set a random secret and short ISO expiry together.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EXPIRES_AT=

# Derived vectors share the application database; Atlas Vector Search is needed for retrieval.
MONGODB_VECTOR_COLLECTION=material_chunks
MONGODB_VECTOR_INDEX=material_vector_index
MONGODB_VECTOR_DIMENSIONS=1536
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_QUESTION_MODEL=gpt-5.6-luna

# inline = PPTX text indexing in the API; worker = queued PDF/image conversion.
MATERIAL_PROCESSING_MODE=inline
LIBREOFFICE_BIN=soffice
PDFTOPPM_BIN=pdftoppm
PDFTOTEXT_BIN=pdftotext
MATERIAL_WORKER_NAME=examcure-worker-1
