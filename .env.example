NODE_ENV=development
PORT=5010
DATABASE_PATH=./data/examcure.sqlite
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
DEV_EXPOSE_OTP=true

# Google OAuth access token verification
GOOGLE_CLIENT_ID=

# Required in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ExamCure <no-reply@examcure.local>
