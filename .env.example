NODE_ENV=development
PORT=5010
DATABASE_PATH=./data/examcure.sqlite
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
DEV_EXPOSE_OTP=true
# Supabase Auth is the default in all environments. Legacy routes are opt-in
# only for compatibility tests or migration; ExamCureUI does not call them.
ENABLE_LEGACY_AUTH=false

# Google OAuth access token verification
GOOGLE_CLIENT_ID=

# Required in production only when ENABLE_LEGACY_AUTH=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ExamCure <no-reply@examcure.local>

# Supabase primary database and Storage (server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_BOOTSTRAP_TOKEN=
# Optional first-admin setup only. Both fields required; use an ISO timestamp
# with timezone, e.g. a short-lived expiry ending in Z. Remove after setup.
ADMIN_BOOTSTRAP_EXPIRES_AT=

# MongoDB Atlas Vector Search
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGODB_DATABASE=examcure
MONGODB_VECTOR_COLLECTION=material_chunks
MONGODB_VECTOR_INDEX=material_vector_index
MONGODB_VECTOR_DIMENSIONS=1536

# OpenAI (server and worker only)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_QUESTION_MODEL=gpt-5.6-luna

# Supabase Storage buckets
SUPABASE_ORIGINALS_BUCKET=material-originals
SUPABASE_PREVIEWS_BUCKET=material-previews
SUPABASE_SLIDES_BUCKET=slide-images

# PowerPoint worker binaries
LIBREOFFICE_BIN=soffice
PDFTOPPM_BIN=pdftoppm
PDFTOTEXT_BIN=pdftotext
MATERIAL_WORKER_NAME=examcure-worker-1
